@model ProductModel
@{
    ViewData["Title"] = "Edit Product";
    var categories = ViewBag.Categories as List<CategoryModel>;
}

<style>
    .action-btn {
        width: 90px;
        height: 38px;
        display: inline-flex;
        justify-content: center;
        align-items: center;
        text-align: center;
    }

    .text-danger {
        color: red;
        font-size: 14px;
    }
</style>

<h2>Edit Product</h2>

<div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

<form method="post" id="productForm">

    <input type="hidden" asp-for="ProductId" />

    <div class="form-group">
        <label asp-for="ProductName"></label>
        <input asp-for="ProductName" class="form-control" />
        <span asp-validation-for="ProductName" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="CategoryId"></label>
        <select asp-for="CategoryId"
                class="form-control"
                asp-items="@(new SelectList(categories, "CategoryId", "CategoryName"))">
            <option value="">Select Category</option>
        </select>
        <span asp-validation-for="CategoryId" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Price"></label>
        <input asp-for="Price"
               id="Price"
               class="form-control"
               type="number"
               min="1"
               max="1000" />
        <span asp-validation-for="Price" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Quantity"></label>
        <input asp-for="Quantity"
               id="Quantity"
               class="form-control"
               type="number"
               min="1"
               max="1000" />
        <span asp-validation-for="Quantity" class="text-danger"></span>
    </div>

    <div style="margin-top:15px;">
        <button type="submit" class="btn btn-success action-btn">
            Update
        </button>

        <a href="@Url.Action("Index")" class="btn btn-primary action-btn">
            Cancel
        </a>
    </div>

</form>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />

    <script>

        $(function () {

            function validatePrice() {

                var value = $("#Price").val();

                if (value == "")
                    return true;

                value = parseFloat(value);

                if (value < 1 || value > 1000) {

                    $('[data-valmsg-for="Price"]')
                        .text("Price must be between 1 and 1000.");

                    return false;
                }

                $('[data-valmsg-for="Price"]').text("");
                return true;
            }

            function validateQuantity() {

                var value = $("#Quantity").val();

                if (value == "")
                    return true;

                value = parseInt(value);

                if (value < 1 || value > 1000) {

                    $('[data-valmsg-for="Quantity"]')
                        .text("Quantity must be between 1 and 1000.");

                    return false;
                }

                $('[data-valmsg-for="Quantity"]').text("");
                return true;
            }

            $("#Price").keyup(validatePrice);
            $("#Price").change(validatePrice);

            $("#Quantity").keyup(validateQuantity);
            $("#Quantity").change(validateQuantity);

            $("#productForm").submit(function (e) {

                var p = validatePrice();
                var q = validateQuantity();

                if (!p || !q) {
                    e.preventDefault();
                    return false;
                }

            });

        });

    </script>
}