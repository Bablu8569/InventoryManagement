@model InventoryManagement.Models.ProductModel

@{
    ViewData["Title"] = "Add Product";

    var categories = ViewBag.Categories as List<InventoryManagement.Models.CategoryModel>;
}

<h2>Add Product</h2>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        @TempData["Success"]
    </div>
}

<form asp-action="Create" method="post" id="productForm">

    @Html.AntiForgeryToken()

    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

    <div class="form-group mb-3">
        <label asp-for="ProductName" class="form-label"></label>
        <input asp-for="ProductName" class="form-control" />
        <span asp-validation-for="ProductName" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="CategoryId" class="form-label"></label>

        <select asp-for="CategoryId"
                class="form-control"
                asp-items="@(new SelectList(categories, "CategoryId", "CategoryName"))">
            <option value="">-- Select Category --</option>
        </select>

        <span asp-validation-for="CategoryId" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="Price" class="form-label"></label>

        <input asp-for="Price"
               class="form-control"
               type="number"
               min="1"
               max="1000" />

        <span asp-validation-for="Price" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="Quantity" class="form-label"></label>

        <input asp-for="Quantity"
               class="form-control"
               type="number"
               min="1"
               max="1000" />

        <span asp-validation-for="Quantity" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-success">
        Save
    </button>

    <a asp-action="Index" class="btn btn-secondary">
        Cancel
    </a>

</form>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}