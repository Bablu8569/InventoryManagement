@model List<InventoryManagement.Models.StockTransactionModel>
@{
    ViewData["Title"] = "Transaction History";
}

<!-- AG Grid CSS & JS -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/ag-grid-community@31.3.2/styles/ag-grid.css">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/ag-grid-community@31.3.2/styles/ag-theme-alpine.css">
<script src="https://cdn.jsdelivr.net/npm/ag-grid-community@31.3.2/dist/ag-grid-community.min.js"></script>
<link rel="stylesheet" href="~/css/transaction-history.css" />

<div class="history-page">
    <h2>📜 Transaction History</h2>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Filter Section -->
    <div class="filter-section">
        <!-- Step 1: Form me id add ki -->
        <form method="get" asp-action="Index" id="filterForm">

            <div class="filter-row">

                <div class="field">
                    <label>
                        <i class="far fa-calendar-alt"></i> From Date
                    </label>

                    <!-- Step 2: From Date input me id add ki -->
                    <input type="date"
                           id="fromDate"
                           name="fromDate"
                           value="@ViewBag.FromDate" />
                </div>

                <div class="field">
                    <label>
                        <i class="far fa-calendar-alt"></i> To Date
                    </label>

                    <!-- Step 2: To Date input me id add ki -->
                    <input type="date"
                           id="toDate"
                           name="toDate"
                           value="@ViewBag.ToDate" />
                </div>

                <div class="actions">
                    <button type="submit">
                        <i class="fas fa-filter"></i> Apply
                    </button>

                    <a asp-action="Index">
                        <i class="fas fa-eraser"></i> Clear
                    </a>

                    <a href="@Url.Action("ExportCsv", new { fromDate = ViewBag.FromDate, toDate = ViewBag.ToDate })"
                           class="btn-export">
                        📥 Export CSV
                    </a>
                </div>

            </div>

        </form>
    </div>
</div>
    @if (!Model.Any())
    {
        <div class="alert alert-warning">⚠️ No transactions found for the selected date range.</div>
    }
    else
    {
        <!-- AG Grid container -->
        <div id="transactionGrid" class="ag-theme-alpine" style="height: 500px; width: 100%;"></div>
    }

    


<script>
    // Pass Model Data to JavaScript
    const rowData = @Html.Raw(Json.Serialize(Model));
    const dashboardDate = '@ViewBag.FilterDate';

    // AG Grid Columns
    const columnDefs = [

    {
    headerName: "ID",
    field: "transactionId",
    width: 100,
    sortable: true,
    filter: 'agNumberColumnFilter'
    },

    {
    headerName: "Product",
    field: "productName",
    width: 200,
    sortable: true,
    filter: 'agTextColumnFilter'
    },

    {
    headerName: "Quantity",
    field: "quantity",
    width: 120,
    sortable: true,
    filter: 'agNumberColumnFilter',

    valueGetter: (params) => {

    if (params.data.transactionType === "In")
    return "+" + params.data.quantity;

    return "-" + params.data.quantity;
    },

    cellStyle: params => ({
    color: params.data.transactionType === "In"
    ? "green"
    : "red",
    fontWeight: "bold",
    textAlign: "center"
    })
    },

    {
    headerName: "Running Stock",
    field: "runningStock",
    width: 150,
    sortable: true,
    filter: 'agNumberColumnFilter',
    cellStyle: {
    textAlign: "center",
    fontWeight: "bold",
    color: "#2563eb"
    }
    },

    {
    headerName: "Type",
    field: "transactionType",
    width: 140,
    sortable: true,
    filter: 'agTextColumnFilter',

    cellRenderer: (params) => {
    return params.value === "In"
    ? '<span class="type-in">Stock In</span>'
    : '<span class="type-out">Stock Out</span>';
    }
    },

    {
    headerName: "Transaction Date",
    field: "transactionDate",
    width: 150,
    sortable: true,
    filter: 'agDateColumnFilter',
    floatingFilter: true,

    valueFormatter: (params) => {
    return params.value
    ? params.value.split('T')[0]
    : '';
    },

    filterValueGetter: (params) => {
    return params.data.transactionDate
    ? new Date(params.data.transactionDate)
    : null;
    }
    }
    ];

    // Grid Options
    const gridOptions = {
    columnDefs: columnDefs,
    rowData: rowData,

    defaultColDef: {
    sortable: true,
    resizable: true,
    filter: true,
    floatingFilter: true
    },

    pagination: false,
    animateRows: true,
    enableCellTextSelection: true,
    ensureDomOrder: true
    };

    // Initialize Grid
    document.addEventListener('DOMContentLoaded', () => {

    const gridDiv = document.querySelector('#transactionGrid');

    if (gridDiv) {

    new agGrid.Grid(gridDiv, gridOptions);

    if (dashboardDate) {

    const dateFilter =
    gridOptions.api.getFilterInstance('transactionDate');

    dateFilter.setModel({
    type: 'equals',
    dateFrom: dashboardDate
    });

    gridOptions.api.onFilterChanged();
    }
    }
    });
    // Date Filter Validation
    document.getElementById("filterForm").addEventListener("submit", function (e) {

    const fromDate = document.getElementById("fromDate").value;
    const toDate = document.getElementById("toDate").value;

    // From selected but To not selected
    if (fromDate && !toDate) {
    e.preventDefault();
    alert("Please select To Date.");
    document.getElementById("toDate").focus();
    return;
    }

    // To selected but From not selected
    if (!fromDate && toDate) {
    e.preventDefault();
    alert("Please select From Date.");
    document.getElementById("fromDate").focus();
    return;
    }

    // From Date > To Date
    if (fromDate && toDate) {

    const from = new Date(fromDate);
    const to = new Date(toDate);

    if (from > to) {
    e.preventDefault();
    alert("From Date cannot be greater than To Date.");
    document.getElementById("fromDate").focus();
    return;
    }
    }
    });
</script>