@model InventoryManagement.Models.StockEntryModel
@{
    ViewData["Title"] = "Stock Transaction";
}

<link rel="stylesheet" href="~/css/stock-transaction.css" />

<div class="form-container">
    <div class="form-header">
        <h3><i class="fas fa-exchange-alt me-2"></i> Stock Transaction</h3>
    </div>
    <div class="form-body">
        @if (ViewBag.SuccessMessage != null)
        {
            <div class="alert alert-success">
                <i class="fas fa-check-circle me-1"></i>
                @ViewBag.SuccessMessage
            </div>
        }

        <form method="post" asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            <!-- Product Dropdown -->
            <div class="form-group">
                <label class="form-label">
                    <i class="fas fa-box me-1"></i> Select Product
                </label>

                <select asp-for="ProductId"
                        class="form-select"
                        asp-items="@(new SelectList(ViewBag.Products, "ProductId", "ProductName"))">
                    <option value="">-- Select Product --</option>
                </select>

                <span asp-validation-for="ProductId" class="text-danger"></span>
            </div>

            <!-- Quantity -->
           @*  <div class="form-group">
                <label class="form-label"><i class="fas fa-sort-amount-up me-1"></i> Quantity</label>
                <input asp-for="Quantity" class="form-control" type="number" min="1" placeholder="Enter quantity" />
                <span asp-validation-for="Quantity" class="text-danger"></span>
            </div> *@

            <!-- Quantity -->
            <div class="form-group">
                <label class="form-label">
                    <i class="fas fa-sort-amount-up me-1"></i> Quantity
                </label>

                <input asp-for="Quantity"
                       class="form-control"
                       type="number"
                       min="1"
                       max="1000"
                       step="1"
                       placeholder="Enter quantity"
                       onkeydown="return blockInvalidKeys(event)"
                       oninput="validateQuantity(this)" />

                <span asp-validation-for="Quantity" class="text-danger"></span>
            </div>

            <!--  Remarks Field -->
            <div class="form-group">
                <label class="form-label"><i class="fas fa-comment me-1"></i> Remarks</label>
                <input asp-for="Remarks" class="form-control" type="text" placeholder="Add remarks (optional)" />
                <span asp-validation-for="Remarks" class="text-danger"></span>
            </div>

            <!-- Transaction Type -->
            <div class="form-group">
                <label class="form-label"><i class="fas fa-arrow-right-arrow-left me-1"></i> Transaction Type</label>
                <div class="radio-group">
                    <label>
                        <input type="radio" asp-for="TransactionType" value="In" /> Stock In (Add)
                    </label>
                    <label>
                        <input type="radio" asp-for="TransactionType" value="Out" /> Stock Out (Remove)
                    </label>
                </div>
                <span asp-validation-for="TransactionType" class="text-danger"></span>
            </div>

            <hr />
            <div>
                <button type="submit" class="btn-submit"><i class="fas fa-check me-1"></i> Submit</button>
                <a asp-action="Index" class="btn-history"><i class="fas fa-history me-1"></i> View History</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/3.2.13/jquery.validate.unobtrusive.min.js"></script>
    <script>
        // setTimeout(function () {
        // var successAlert = document.getElementById("successAlert");

        // if (successAlert) {
        // successAlert.style.transition = "opacity 0.5s ease";
        // successAlert.style.opacity = "0";

        // setTimeout(function () {
        // successAlert.style.display = "none";
        // }, 500);
        // }
        // }, 4000); // 4000 ms = 4 seconds

        
        function blockInvalidKeys(e) {

        // e, E, +, -, . ko block karega
        if (
        e.key === "e" ||
        e.key === "E" ||
        e.key === "+" ||
        e.key === "-" ||
        e.key === "."
        ) {
        e.preventDefault();
        }
        }

        function validateQuantity(input) {

        if (input.value === "") return;

        let qty = parseInt(input.value);

        if (qty < 1) {
        alert("Minimum quantity is 1.");
        input.value = 1;
        }

        if (qty > 1000) {
        alert("Maximum quantity allowed is 1000.");
        input.value = 1000;
        }
        }
    </script>
    
}