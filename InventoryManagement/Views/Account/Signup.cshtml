@model InventoryManagement.Models.UserModel

@{
    Layout = null;
}

<link rel="stylesheet" href="~/css/signup.css" />

<div class="signup-container">

    <div class="signup-card">

        <h2>Create Account</h2>

        <form asp-action="Signup"
              method="post"
              enctype="multipart/form-data"
              id="signupForm">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly"
                 class="validation-summary-errors"></div>

            <div class="form-row">

                <!-- LEFT COLUMN -->

                <div class="form-column">

                    <div class="form-group">
                        <label>Name</label>
                        <input asp-for="Username"
                               placeholder="Full Name" />

                        <span asp-validation-for="Username"></span>
                    </div>

                    <div class="form-group">
                        <label>Password</label>

                        <input asp-for="Password"
                               type="password"
                               placeholder="Password" />

                        <span asp-validation-for="Password"></span>
                    </div>

                    <div class="form-group">

                        <label>Profile Image</label>

                        <input asp-for="ProfileImageFile"
                               type="file" />

                        <span asp-validation-for="ProfileImageFile"></span>

                    </div>

                    <div class="form-group">

                        <label>Mobile Number</label>

                        <input asp-for="MobileNo"
                               placeholder="Mobile Number" />

                        <span asp-validation-for="MobileNo"></span>

                    </div>

                    <div class="form-group">

                        <label>Marital Status</label>

                        <select asp-for="MaritalStatus">

                            <option value="">-- Select Status --</option>
                            <option>Single</option>
                            <option>Married</option>

                        </select>

                        <span asp-validation-for="MaritalStatus"></span>

                    </div>

                </div>

                <!-- RIGHT COLUMN -->

                <div class="form-column">
                    <div class="form-group">

                        <label>Email</label>

                        <input asp-for="Email"
                               placeholder="Email Address" />

                        <span asp-validation-for="Email"></span>

                    </div>

                    <div class="form-group">

                        <label>Confirm Password</label>

                        <input asp-for="ConfirmPassword"
                               type="password"
                               placeholder="Confirm Password" />

                        <span asp-validation-for="ConfirmPassword"></span>

                    </div>

                    <div class="form-group">

                        <label>Date of Birth</label>

                        <input asp-for="DOB" type="date" />

                        <span asp-validation-for="DOB"></span>

                    </div>

                    <div class="form-group">

                        <label>Gender</label>

                        <div class="gender-group">

                            <label>
                                <input asp-for="Gender"
                                       type="radio"
                                       value="Male" />
                                Male
                            </label>

                            <label>
                                <input asp-for="Gender"
                                       type="radio"
                                       value="Female" />
                                Female
                            </label>

                        </div>

                        <span asp-validation-for="Gender"></span>

                    </div>

                    <div class="form-group">

                        <label>Hobbies</label>

                        <div class="hobby-group">

                            <label>
                                <input type="checkbox"
                                       name="SelectedHobbies"
                                       value="Reading" />
                                Reading
                            </label>

                            <label>
                                <input type="checkbox"
                                       name="SelectedHobbies"
                                       value="Sports" />
                                Sports
                            </label>

                            <label>
                                <input type="checkbox"
                                       name="SelectedHobbies"
                                       value="Music" />
                                Music
                            </label>

                        </div>

                    </div>

                </div>

            </div>

            <!-- ADDRESS -->

            <div class="form-group">

                <label>Address</label>

                <textarea asp-for="Address"
                          placeholder="Enter Address"></textarea>

                <span asp-validation-for="Address"></span>

            </div>

            <!-- BUTTONS -->

            <div class="button-group">

                <button type="button"
                        id="btnReset"
                        class="btn-reset">
                    Reset
                </button>

                <button type="submit"
                        class="btn-signup">
                    Create Account
                </button>

            </div>

        </form>

        <div class="login-link">

            Already have an account?

            <a asp-controller="Account"
               asp-action="Login">
                Login
            </a>

        </div>

    </div>

</div>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
<script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>

<script>
    $(document).ready(function() {

        $("#btnReset").click(function() {

            // Reset form fields
            $("#signupForm")[0].reset();

            // Clear validation messages
            $("span.field-validation-error")
                .removeClass("field-validation-error")
                .addClass("field-validation-valid")
                .html("");

            $(".validation-summary-errors")
                .removeClass("validation-summary-errors")
                .addClass("validation-summary-valid")
                .html("");

            // Remove validation styles
            $(".input-validation-error")
                .removeClass("input-validation-error");

            // Reset jQuery unobtrusive validation
            var form = $("#signupForm");

            form.removeData("validator");
            form.removeData("unobtrusiveValidation");

            $.validator.unobtrusive.parse(form);
        });

    });
</script>