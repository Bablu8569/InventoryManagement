@model InventoryManagement.Models.UserModel
@{
    Layout = null;
}

<!DOCTYPE html>

<html>

<head>

    <meta charset="utf-8" />

    <meta name="viewport" content="width=device-width, initial-scale=1">

    <title>Create Account</title>

    <link rel="stylesheet" href="~/css/signup.css">

</head>

<body>

    <div class="signup-container">

        <div class="signup-card">

            <h2>Create Account</h2>

            <form asp-action="Signup" method="post" enctype="multipart/form-data">

                <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

                <div class="form-row">

                    <!-- LEFT -->

                    <div class="form-column">

                        <div class="form-group">
                            <label>Name</label>
                            <input asp-for="Username" placeholder="Full Name" />
                            <span asp-validation-for="Username"></span>
                        </div>

                        <div class="form-group">
                            <label>Password</label>
                            <input asp-for="Password" type="password" placeholder="Password" />
                            <span asp-validation-for="Password"></span>
                        </div>

                        <div class="form-group">
                            <label>Profile Image</label>
                            <input asp-for="ProfileImageFile" type="file" />
<span asp-validation-for="ProfileImageFile" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <label>Mobile No</label>
                            <input asp-for="MobileNo" placeholder="Mobile Number" />
                        </div>

                        <div class="form-group">
                            <label>Marital Status</label>

                            <select asp-for="MaritalStatus">

                                <option value="">-- Select Status --</option>

                                <option>Single</option>

                                <option>Married</option>

                            </select>

                        </div>

                    </div>

                    <!-- RIGHT -->

                    <div class="form-column">

                        <div class="form-group">
                            <label>Email</label>
                            <input asp-for="Email" placeholder="Email Address" />
                            <span asp-validation-for="Email"></span>
                        </div>

                        <div class="form-group">
                            <label>Confirm Password</label>
                            <input asp-for="ConfirmPassword" type="password" placeholder="Confirm Password" />
                            <span asp-validation-for="ConfirmPassword"></span>
                        </div>

                        <div class="form-group">
                            <label>DOB</label>
                            <input asp-for="DOB" type="date" />
                        </div>

                        <div class="form-group">

                            <label>Gender</label>

                            <div class="gender-group">

                                <label>

                                    <input type="radio"
                                           asp-for="Gender"
                                           value="Male">

                                    Male

                                </label>

                                <label>

                                    <input type="radio"
                                           asp-for="Gender"
                                           value="Female">

                                    Female

                                </label>

                            </div>

                        </div>

                      <div class="form-group">
                        <label>Hobbies</label>

                        <div class="hobby-group">
                            <label>
                                <input type="checkbox" name="SelectedHobbies" value="Reading" />
                                Reading
                            </label>

                            <label>
                                <input type="checkbox" name="SelectedHobbies" value="Sports" />
                                Sports
                            </label>

                            <label>
                                <input type="checkbox" name="SelectedHobbies" value="Music" />
                                Music
                            </label>
                        </div>
                    </div>

                <div class="form-group">

                    <label>Address</label>

                    <textarea asp-for="Address"
                              placeholder="Enter Address"></textarea>

                </div>

                <div class="button-group">

                    <button type="reset" class="btn-reset">

                        Reset

                    </button>

                    <button type="submit" class="btn-signup">

                        Create Account

                    </button>

                </div>

            </form>

            <div class="login-link">

                Already have an account?

                <a asp-controller="Account"
                   asp-action="Login">

                    Login

                </a>

            </div>

        </div>

    </div>

</body>

</html>

        