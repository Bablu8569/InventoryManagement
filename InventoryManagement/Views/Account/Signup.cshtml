@model InventoryManagement.Models.UserModel
@{
    Layout = null;
}

<!DOCTYPE html>

<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Create Account</title>

    <link rel="stylesheet"
          href="~/css/signup.css" />

    <!-- Font Awesome -->

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />

</head>

<body>

    <div class="signup-container">

        <div class="signup-card">

            <h2>Create Account</h2>

            <p class="subtitle">

                Inventory Management System

            </p>

            <form asp-action="Signup"
                  method="post"
                  id="signupForm">

                <!-- Validation Summary -->

                <div asp-validation-summary="ModelOnly"
                     class="validation-summary-errors">
                </div>

                <!-- Username -->

                <div class="form-group">

                    <label asp-for="Username"></label>

                    <div class="password-box">

                        <input asp-for="Username"
                               maxlength="20"
                               placeholder="Enter Username" />

                        <span class="toggle-password"
                              style="pointer-events:none;cursor:default;">

                            <i class="fa-solid fa-user"></i>

                        </span>

                    </div>

                    <span asp-validation-for="Username"
                          class="field-validation-error"></span>

                </div>

                <!-- Email -->

                <div class="form-group">

                    <label asp-for="Email"></label>

                    <div class="password-box">

                        <input asp-for="Email"
                               type="email"
                               placeholder="Enter Email Address" />

                        <span class="toggle-password"
                              style="pointer-events:none;cursor:default;">

                            <i class="fa-solid fa-envelope"></i>

                        </span>

                    </div>

                    <span asp-validation-for="Email"
                          class="field-validation-error"></span>

                </div>

                <!-- Password -->

                <div class="form-group">

                    <label asp-for="Password"></label>

                    <div class="password-box">

                        <input asp-for="Password"
                               id="Password"
                               type="password"
                               placeholder="Enter Password" />

                        <span class="toggle-password"
                              data-target="#Password">

                            <i class="fa-solid fa-eye"></i>

                        </span>

                    </div>

                    <span asp-validation-for="Password"
                          class="field-validation-error"></span>

                </div>

                <!-- Confirm Password -->

                <div class="form-group">

                    <label asp-for="ConfirmPassword"></label>

                    <div class="password-box">

                        <input asp-for="ConfirmPassword"
                               id="ConfirmPassword"
                               type="password"
                               placeholder="Confirm Password" />

                        <span class="toggle-password"
                              data-target="#ConfirmPassword">

                            <i class="fa-solid fa-eye"></i>

                        </span>

                    </div>

                    <span asp-validation-for="ConfirmPassword"
                          class="field-validation-error"></span>

                </div>

                <button type="submit"
                        class="btn-signup">

                    <i class="fa-solid fa-user-plus"></i>

                    &nbsp;

                    Create Account

                </button>

            </form>

            <div class="login-link">

                Already have an account?

                <a asp-controller="Account"
                       asp-action="Login">

                    Sign In

                </a>

            </div>

        </div>

    </div>

    <!-- jQuery -->

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <!-- Validation -->

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/3.2.13/jquery.validate.unobtrusive.min.js"></script>

    <script>

        $(function () {

        $(".toggle-password").click(function () {

        var target = $(this).data("target");

        if (!target)
        return;

        var input = $(target);

        var icon = $(this).find("i");

        if (input.attr("type") === "password") {

        input.attr("type", "text");

        icon.removeClass("fa-eye");

        icon.addClass("fa-eye-slash");

        }
        else {

        input.attr("type", "password");

        icon.removeClass("fa-eye-slash");

        icon.addClass("fa-eye");

        }

        });

        });

    </script>

    @if (TempData["SignupSuccess"] != null)
    {
        <script>

            alert('@Html.Raw(TempData["SignupSuccess"])');

            window.location.href='@Url.Action("Login", "Account")';

        </script>
    }

</body>

</html>